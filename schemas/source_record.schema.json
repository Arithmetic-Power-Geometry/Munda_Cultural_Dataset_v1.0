{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlhkp.org/schemas/source_record.schema.json",
  "title": "MLHKP Universal Source Record",
  "type": "object",
  "required": [
    "source_id",
    "source_class",
    "title",
    "creator",
    "year",
    "source_type",
    "geographic_scope",
    "access_class",
    "reuse_status",
    "ingestion_status",
    "verification_status"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9-]*$"},
    "collection_id": {"type": ["string", "null"], "pattern": "^SRC-COL-[A-Z0-9][A-Z0-9-]*$"},
    "source_class": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": ["string", "null"]},
    "creator": {"type": "string", "minLength": 1},
    "contributors": {"type": "array", "items": {"type": "string"}},
    "editor": {"type": ["string", "null"]},
    "translator": {"type": ["string", "null"]},
    "publisher": {"type": ["string", "null"]},
    "publication_place": {"type": ["string", "null"]},
    "year": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "minLength": 1}]},
    "edition": {"type": ["string", "null"]},
    "volume": {"type": ["integer", "string", "null"]},
    "issue": {"type": ["integer", "string", "null"]},
    "pages": {"type": ["string", "null"]},
    "language": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "geographic_scope": {"type": "string"},
    "temporal_scope": {"type": ["string", "null"]},
    "scope_note": {"type": ["string", "null"]},
    "identifiers": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "null"]}
    },
    "locators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["locator_type", "value"],
        "properties": {
          "locator_type": {"type": "string"},
          "value": {"type": "string"},
          "label": {"type": ["string", "null"]},
          "is_primary": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "access_class": {
      "type": "string",
      "enum": ["OPEN", "COMMUNITY_ACCESS_ONLY", "RESEARCH_RESTRICTED", "EMBARGOED", "CONFIDENTIAL", "NOT_FOR_PUBLICATION"]
    },
    "reuse_status": {"type": "string", "minLength": 1},
    "copyright_note": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "ingestion_status": {
      "type": "string",
      "enum": ["registered", "pending_ingestion", "partially_ingested", "ingested", "superseded", "withdrawn"]
    },
    "transcription_status": {
      "type": "string",
      "enum": ["not_applicable", "not_started", "ocr_only", "partially_verified", "verified", "requires_specialist_review"]
    },
    "verification_status": {
      "type": "string",
      "enum": ["registered", "metadata_verified", "source_verified", "content_partially_verified", "content_verified", "requires_review"]
    },
    "evidence_period": {"type": ["string", "null"]},
    "source_of_truth_policy": {"type": ["string", "null"]},
    "cultural_sensitivity": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "legacy": {
      "type": "object",
      "additionalProperties": true
    },
    "extended_data": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
